{
  // wrangler.jsonc
  "name": "claude-manual",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/m/*"]
  },
  "r2_buckets": [
    { "binding": "MANUALS", "bucket_name": "motornote-manual-site" }
  ]
}
